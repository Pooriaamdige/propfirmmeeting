# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://propfirm.rokhsarweb.com

# ---------------------------------------------------------------------------
# Database
# Leave DATABASE_URL empty to use the embedded database (PGlite) stored in PGLITE_DIR.
# Use PostgreSQL if you run more than one app process/server.
# ---------------------------------------------------------------------------
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# ---------------------------------------------------------------------------
# Admin panel (/admin)
# The first admin is created from these on first start (only if no admin exists).
# You can also run: npm run admin:create -- you@example.com "password"
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Admin cookies are "Secure" in production. Set to false ONLY if the site is served over plain http.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Live market data
# live (default) = real providers with automatic fallback · mock = offline demo data
# ---------------------------------------------------------------------------
MARKET_DATA_PROVIDER=live

# Forex + XAUUSD (+ calculated DXY): OANDA — FREE real-time with a demo (practice) account token.
# oanda.com → open a free demo account → "Manage API Access" → generate token.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=          # optional (faster: one request for all prices)
OANDA_ENV=practice         # practice | live

# Twelve Data (optional fallback). Free plan = 8 credits/min, far too small for live prices.
TWELVEDATA_API_KEY=
TWELVEDATA_CREDITS_PER_MINUTE=8   # set to your plan's limit; calls beyond it are skipped (no 429s)

# Provider order (first = preferred; providers without credentials are skipped)
MARKET_FX_PROVIDERS=oanda,twelvedata,yahoo
MARKET_CRYPTO_PROVIDERS=binance,coinbase,yahoo
# Refresh intervals (seconds). Every visitor shares one upstream request per interval.
MARKET_FX_QUOTE_TTL_SECONDS=10
MARKET_CRYPTO_QUOTE_TTL_SECONDS=5

# Economic calendar / news: forexfactory (default) | mock
CALENDAR_PROVIDER=forexfactory

# If the server's IP is blocked by providers (common for servers in Iran),
# route provider requests through a proxy outside the restricted region.
# Supports http://user:pass@host:port and socks5://user:pass@host:port
# (e.g. a local v2ray/xray client: socks5://127.0.0.1:10808 or http://127.0.0.1:10809)
OUTBOUND_PROXY_URL=

# ---------------------------------------------------------------------------
# Spam protection (optional): Cloudflare Turnstile on the lottery form
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=change-me
