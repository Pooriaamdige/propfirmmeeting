# Public site URL (used for canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com

# Market data: "mock" (development only) | "live"
# live = Twelve Data for forex/metals/DXY + Binance public API for crypto
MARKET_DATA_PROVIDER=live
TWELVEDATA_API_KEY=

# Economic calendar / news: "mock" (development only) | "forexfactory"
CALENDAR_PROVIDER=forexfactory

# PostgreSQL (lottery registrations + newsletter)
DATABASE_URL=postgres://user:password@localhost:5432/propfirm

# Active lottery campaign id
LOTTERY_CAMPAIGN_ID=2026-autumn

# Cloudflare Turnstile (spam protection). When the secret is set, the server requires a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
